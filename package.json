{
  "name": "roadracer",
  "version": "1.0.0",
  "private": true,
  "description": "Road Racer — a vibe coding craft by Leo, age 10. Single-file HTML5 canvas game.",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "serve --listen ${PORT:-8000} --no-clipboard mobile/assets",
    "mobile:install": "cd mobile && flutter pub get",
    "mobile:analyze": "cd mobile && flutter analyze",
    "mobile:run": "cd mobile && flutter run",
    "mobile:build:ios": "cd mobile && flutter build ios --release --no-codesign",
    "mobile:build:ipa": "cd mobile && flutter build ipa",
    "mobile:pods": "cd mobile/ios && pod install"
  },
  "devDependencies": {
    "serve": "^14.2.4"
  }
}
